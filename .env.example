# Copiar para .env.local (ou cadastrar no painel da Hostinger). Nenhuma é obrigatória para o build.

# Domínio oficial, sem barra no fim. Usado no canonical, Open Graph, sitemap, robots, schema e llms.txt.
# Sem ele, as URLs saem com http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Medição e anúncios: sem ID, a ferramenta não carrega e o aviso de cookies não aparece.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# Search Console: só o código do content da meta "google-site-verification".
GOOGLE_SITE_VERIFICATION=

# Banco MySQL dos contatos (formulário e Monte sua peça). Já cadastradas no painel da Hostinger
# (DB_HOST=127.0.0.1). Sem elas, a rota /api/contatos responde ok e não grava (normal no PC).
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
